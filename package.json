{
  "name": "national-kitchens-olympiad",
  "version": "1.6.41",
  "author": "Постовит Д.А.",
  "description": "Автономная веб-олимпиада по национальным кухням",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "desktop:start": "electron .",
    "desktop:dist": "electron-builder --win portable",
    "test": "node --test",
    "export:bank": "node scripts/export-question-bank.js",
    "export:content": "node scripts/export-content-catalog.js",
    "verify:pm01": "node scripts/verify-pm01-production.js",
    "build:cloudflare": "node scripts/build-cloudflare-pages.js",
    "verify:cloudflare": "node scripts/verify-pm01-production.js",
    "cloudflare:export": "node scripts/export-cloudflare-migration.js",
    "cloudflare:import": "node scripts/import-cloudflare-migration.js"
  },
  "dependencies": {
    "@ydbjs/auth": "^6.2.1",
    "@ydbjs/core": "^6.1.0",
    "@ydbjs/query": "^6.0.7"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.5",
    "wrangler": "^4.20.0"
  },
  "build": {
    "appId": "ru.gktis.national-kitchens-olympiad",
    "productName": "Olympiad National Kitchens",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "electron-main.js",
      "package.json",
      "config/**/*",
      "data/**/*",
      "public/**/*",
      "src/**/*"
    ],
    "extraMetadata": {
      "main": "electron-main.js"
    },
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Olympiad-National-Kitchens-${version}.exe"
    }
  }
}
