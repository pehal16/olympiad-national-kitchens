SITE_DOMAIN=olympiada.gorlkts.ru

HOST=0.0.0.0
PORT=8080
NODE_ENV=production

STORAGE_BACKEND=ydb
YDB_CONNECTION_STRING=grpcs://ydb.serverless.yandexcloud.net:2135/?database=/ru-central1/...

# Для Yandex Compute VM с привязанным сервисным аккаунтом оставьте metadata-auth.
# Для внешнего VPS используйте долгоживущие YDB static credentials, если они настроены.
YDB_METADATA_CREDENTIALS=1
# YDB_STATIC_CREDENTIALS_USER=
# YDB_STATIC_CREDENTIALS_PASSWORD=

YDB_ATTEMPTS_TABLE=olympiad_attempts
YDB_ATTEMPT_VARIANTS_TABLE=olympiad_attempt_variants
YDB_ATTEMPT_ANSWERS_TABLE=olympiad_attempt_answers
YDB_ADMIN_SESSIONS_TABLE=admin_sessions
YDB_CONTENT_DRAFTS_TABLE=olympiad_content_drafts
YDB_CONTENT_QUESTIONS_TABLE=olympiad_content_questions
YDB_PM01_VOICE_AUDIO_TABLE=olympiad_pm01_voice_audio
YDB_AUTO_CREATE_TABLES=true

ADMIN_PASSWORD=change_me

YANDEX_DISK_ENABLED=true
YANDEX_DISK_OAUTH_TOKEN=change_me
YANDEX_DISK_FOLDER=/Олимпиада_Национальные_кухни
